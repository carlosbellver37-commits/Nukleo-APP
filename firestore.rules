rules_version = '2';

// Solo las cuentas con sesión iniciada pueden leer o escribir datos de nukleo.
// El registro libre está desactivado en Firebase Authentication, así que las únicas
// cuentas que existen son las que creáis vosotros en Authentication → Usuarios.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
